@echo off
chcp 65001 > nul
title 깃허브(GitHub) ➔ 소모품 대시보드 풀(다운로드) 동기화
echo ========================================================
echo   (주)에스앤더블류 소모품 대시보드 - GitHub 풀 (내려받기)
echo   원격 저장소: https://github.com/taehoon2531/GUME
echo ========================================================
echo.

set "GIT_CMD=C:\Users\user\AppData\Local\Programs\Git\cmd\git.exe"

cd /d "%~dp0"

echo [1/2] 깃허브 최신 내역 가져오는 중...
"%GIT_CMD%" pull origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ========================================================
    echo  [성공] 깃허브의 최신 코드를 성공적으로 반영(Pull)했습니다!
    echo ========================================================
) else (
    echo.
    echo --------------------------------------------------------
    echo  [안내] 풀 도중 오류가 발생했습니다.
    echo  네트워크 연결 상태나 깃허브 권한을 확인해주세요.
    echo --------------------------------------------------------
)

echo.
echo 창을 닫으려면 아무 키나 누르세요...
pause > nul
